NODE_ENV=development

# App
APP_PORT=5555
APP_NAME="MedDx"
APP_LOGO=

# URLs
BACKEND_URL=http://localhost:5555
CLIENT_URL=http://localhost:8888

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/meddx?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
SESSION_SECRET_KEY=replace-me-with-a-long-random-string

# Google OAuth (optional — boilerplate carryover, not used by MedDx)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail (Nodemailer App Password). If blank, doctor set-password link
# is returned in the admin UI fallback instead of being emailed.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Groq AI
GROQ_API_KEY=

# Razorpay (TEST mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (single URL form: cloudinary://<key>:<secret>@<cloud>)
CLOUDINARY_URL=
